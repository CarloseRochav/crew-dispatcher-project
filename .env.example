# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Never add the service role key here or anywhere in the repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RLS tests only (npm test). Passwords of the three demo users in Authentication > Users.
TEST_DISPATCHER_PASSWORD=
TEST_NORTH_CREW_PASSWORD=
TEST_SOUTH_CREW_PASSWORD=

# Job summaries (Step 14b). Server-only: never add NEXT_PUBLIC_ to these.
# Azure AI Foundry > your resource > Keys and Endpoint, and Deployments for the model name.
# Leave empty to run without AI: the Summary tab then says it isn't set up.
AZURE_OPENAI_BASE_URL=          # https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=        # your deployment name, e.g. gpt-5-mini
